# Sushaasan environment contract — set these in Vercel → Project → Settings → Environment Variables.
# Everything degrades gracefully when unset (seed data / feature off), but this is what "fully on" looks like.

# ── Database (Supabase) — REQUIRED for live data ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # OPTIONAL fallback only. The pipeline runs on Sarvam by default;
                                   # this is never consulted when SARVAM_ONLY is set.
# AI_PROVIDER=anthropic            # anthropic | sarvam | bharatgen (sovereign-AI switch, falls back to Claude)

# ── Sarvam AI (sovereign models) — see docs/SARVAM.md ────────────────────────
# One key powers STT, TTS, translation, document extraction and the LLM.
# Every Sarvam path degrades gracefully when unset: STT falls back to Whisper,
# the LLM falls back to Claude, and voice/document controls hide themselves.
SARVAM_API_KEY=                    # Startup Program credits; also read by the sarvam MCP server
# SARVAM_ONLY=true                 # Sovereign mode: Sarvam or nothing. No Whisper/Claude fallback,
                                   # no cross-border reroute on failure. Set this in production if
                                   # "runs on Indian models" needs to be defensible.
# SARVAM_PRONUNCIATION_DICT_ID=    # from `createPuneDictionary()` — makes TTS say NIBM/Kondhwa correctly
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_MODEL=sarvam-30b          # chat completions default
# SARVAM_MODEL_FLAGSHIP=sarvam-105b  # used for solution synthesis only
# SARVAM_STT_MODEL=saaras:v3       # 23 languages, auto-detect
# SARVAM_TTS_MODEL=bulbul:v3       # 11 languages, 38 voices
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TTS_SPEAKER_CITIZEN=shreya  # reads grievances back to residents
# SARVAM_TTS_SPEAKER_OFFICIAL=anand  # reads briefs to ward officers
# BHARATGEN_API_KEY=
# VOYAGE_API_KEY=                  # voyage-3 embeddings (optional; classification works without)

# ── Scraping ──────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=                   # Twitter / Instagram / Facebook / Google Maps actors

# ── Jobs (Inngest) ────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Cron protection ───────────────────────────────────────────────────────────
CRON_SECRET=                       # Vercel auto-attaches this as Bearer on cron calls; endpoints run open when unset

# ── Access gates ──────────────────────────────────────────────────────────────
GOV_ACCESS_TOKEN=                  # /gov war room (?token=)
ADMIN_TOKEN=                       # /admin pages + admin APIs (?token=)

# ── Authority outreach (email / WhatsApp) ────────────────────────────────────
RESEND_API_KEY=                    # email delivery (verify the sushaasan.in domain in Resend)
# DISPATCH_FROM=Sushaasan <briefs@sushaasan.in>
FOUNDER_EMAIL=                     # weekly founder digest + fallback recipient of the daily war-room digest
# AUTHORITY_DIGEST_EMAILS=         # comma-separated; overrides FOUNDER_EMAIL as daily-digest audience once authority inboxes are verified
# WHATSAPP_ACCESS_TOKEN=           # Meta WhatsApp Business Cloud API (see docs/OUTREACH.md)
# WHATSAPP_PHONE_NUMBER_ID=

# ── Misc ──────────────────────────────────────────────────────────────────────
# PUBLIC_BASE_URL=https://sushaasan.in
# SENTRY_DSN=
# PLAUSIBLE_DOMAIN=sushaasan.in
