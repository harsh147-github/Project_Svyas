# Sushaasan environment contract — set these in Vercel → Project → Settings → Environment Variables.
# Everything degrades gracefully when unset (seed data / feature off), but this is what "fully on" looks like.

# ── Database (Supabase) — REQUIRED for live data ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── AI — sovereign by default ─────────────────────────────────────────────────
# Sushaasan runs on Sarvam (made-in-India inference). That is the default with
# no AI_PROVIDER set; Anthropic is the fallback that keeps the product up while
# the migration completes. Every fallback is recorded in ai_provider_events and
# surfaced at /api/health as `ai.last_24h.sovereignty_pct` — drive it to 100.
SARVAM_API_KEY=                    # REQUIRED — without it every call silently runs on Claude
ANTHROPIC_API_KEY=                 # fallback only; drop once sovereignty holds at 100%
# AI_PROVIDER=sarvam               # sarvam (default) | bharatgen | anthropic
# AI_TIMEOUT_SEC=60                # sovereign-provider request timeout (max 280). Raise if Sarvam
#                                  # times out on long synthesis prompts — a timeout is a lost
#                                  # sovereign call, not just a slow one.
# AI_STRICT_SOVEREIGN=false        # true = no Claude fallback; sovereign failures surface as errors.
#                                  # Use in preview to find every gap fast. Leave false in production
#                                  # until the fallback rate is already zero.
# BHARATGEN_API_KEY=
# VOYAGE_API_KEY=                  # voyage-3 embeddings (optional; classification works without)
# Model overrides — all optional. Defaults live in apps/web/lib/models.ts (single source of truth).
# CLASSIFY_MODEL=                  # overrides the per-post classifier model (default claude-sonnet-4-6)
# SOLUTION_MODEL=                  # overrides the Inngest weekly solution-synthesis model (default claude-opus-4-6)
# OPUS_MODEL=                      # overrides the /api/admin/generate-briefs model (default claude-opus-4-6)
# INTAKE_MODEL=                    # overrides the /api/add-report grievance-synthesis model
# SARVAM_BASE_URL=                 # base URL, e.g. https://api.sarvam.ai/v1 — chat endpoint derived as
                                    # ${SARVAM_BASE_URL}/chat/completions. Default: https://api.sarvam.ai/v1
# SARVAM_MODEL=                    # default sarvam-105b — Sarvam's own model id, not a Claude one
# BHARATGEN_API_URL=               # REQUIRED for AI_PROVIDER=bharatgen — no default endpoint exists
# BHARATGEN_MODEL=                 # default bharatgen-chat

# ── Scraping ──────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=                   # Twitter / Instagram / Facebook / Google Maps actors
# TWITTER_TIMEOUT_SEC=             # per-actor Apify timeout override (default 200, max 280)
# GMAPS_TIMEOUT_SEC=               # per-actor Apify timeout override (default 240, max 280)
# Reddit: unauthenticated .json is blocked from datacenter IPs (i.e. Vercel).
# Register a "script" app at https://www.reddit.com/prefs/apps and set these two
# to switch the scraper to authenticated OAuth. Unset = current fallback behaviour.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=               # e.g. "Sushasan/1.0 (civic; you@example.com)"

# ── Jobs (Inngest) ────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Cron protection ───────────────────────────────────────────────────────────
CRON_SECRET=                       # Vercel auto-attaches this as Bearer on cron calls; endpoints run open when unset

# ── Access gates ──────────────────────────────────────────────────────────────
GOV_ACCESS_TOKEN=                  # /gov war room (?token=)
ADMIN_TOKEN=                       # /admin pages + admin APIs (?token=)

# ── Authority outreach (email / WhatsApp) ────────────────────────────────────
RESEND_API_KEY=                    # email delivery (verify the sushaasan.in domain in Resend)
# DISPATCH_FROM=Sushaasan <briefs@sushaasan.in>
FOUNDER_EMAIL=                     # weekly founder digest + fallback recipient of the daily war-room digest
# AUTHORITY_DIGEST_EMAILS=         # comma-separated; overrides FOUNDER_EMAIL as daily-digest audience once authority inboxes are verified
# WARD_DIGEST_FROM=                # sender identity for the per-ward-officer daily war-room digest
                                    # (api/cron/ward-warroom-digest) — a different feature from the
                                    # AUTHORITY_DIGEST_EMAILS one above. Never falls back to FOUNDER_EMAIL;
                                    # that route intentionally never CCs or replies-to the founder.
# WHATSAPP_ACCESS_TOKEN=           # Meta WhatsApp Business Cloud API (see docs/OUTREACH.md)
# WHATSAPP_PHONE_NUMBER_ID=

# ── Misc ──────────────────────────────────────────────────────────────────────
# PUBLIC_BASE_URL=https://sushaasan.in
# SENTRY_DSN=
# PLAUSIBLE_DOMAIN=sushaasan.in
