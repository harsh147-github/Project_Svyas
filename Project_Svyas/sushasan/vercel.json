{
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install && cd apps/web && npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/daily-pipeline",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/admin/generate-briefs",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/gov-dispatch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/founder-digest",
      "schedule": "30 3 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/geojson/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=120, stale-while-revalidate=60"
        }
      ]
    }
  ]
}
