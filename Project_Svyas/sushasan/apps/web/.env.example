# Sushasan / apps/web — authoritative environment variable contract.
# Every var actually read by the code lives here. REQUIRED vars are validated
# at boot in production by lib/env-check.ts; missing ones fail closed instead
# of degrading silently. See CLAUDE.md §12 for the narrative version.

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── AI providers ────────────────────────────────────────────────────────
# AI_PROVIDER selects the primary chat provider. Single default across the
# whole app: sarvam. Set to `anthropic` to force Claude, or `bharatgen` for
# the BharatGen-compatible endpoint. Sarvam failures fall back to Anthropic
# automatically (see lib/ai.ts) — both keys below are REQUIRED until the
# fallback rate holds at zero.
AI_PROVIDER=sarvam
SARVAM_API_KEY=
# Base URL only — every call site derives its own endpoint
# (e.g. `${SARVAM_BASE_URL}/chat/completions`). Do NOT put a full endpoint
# path here.
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-m
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_SYNTH=
CLASSIFY_MODEL=
SOLUTION_MODEL=
OPUS_MODEL=
INTAKE_MODEL=
AI_STRICT_SOVEREIGN=
AI_TIMEOUT_SEC=30

# BharatGen — optional third provider, off by default (AI_PROVIDER=bharatgen
# to use). BHARATGEN_API_URL has no default; leaving it unset while selected
# fails at env-check rather than at request time.
BHARATGEN_API_KEY=
BHARATGEN_API_URL=
BHARATGEN_MODEL=

# Fallback STT providers for /api/transcribe (OPTIONAL — Sarvam is primary)
GROQ_API_KEY=
OPENAI_API_KEY=

# Voyage embeddings (REQUIRED for classification/clustering)
VOYAGE_API_KEY=

# ── Scraping (REQUIRED) ────────────────────────────────────────────────────
APIFY_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sushasan-civic-scraper/1.0

# ── Jobs ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Email / dispatch (REQUIRED) ────────────────────────────────────────────
RESEND_API_KEY=
FOUNDER_EMAIL=
DISPATCH_FROM=
AUTHORITY_DIGEST_EMAILS=

# WhatsApp dispatch (OPTIONAL)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Access control (REQUIRED in production) ────────────────────────────────
# Cron routes fail closed (503) in production if CRON_SECRET is unset.
CRON_SECRET=
GOV_ACCESS_TOKEN=
# Signing secret for per-recipient gov brief links (see lib/gov-token.ts) —
# never send GOV_ACCESS_TOKEN itself in emails/WhatsApp.
GOV_TOKEN_SIGNING_SECRET=
ADMIN_TOKEN=

# ── Public URLs / analytics ─────────────────────────────────────────────
# Used to build absolute links in emails/WhatsApp instead of trusting the
# request Host header.
PUBLIC_BASE_URL=https://sushasan.in
PLAUSIBLE_DOMAIN=sushasan.in

# ── Rate limiting (REQUIRED in production for public write endpoints) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability (OPTIONAL) ────────────────────────────────────────────
SENTRY_DSN=
SLACK_ALERT_WEBHOOK_URL=
