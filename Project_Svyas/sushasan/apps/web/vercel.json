{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/daily-pipeline",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/admin/generate-briefs",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/gov-dispatch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/founder-digest",
      "schedule": "30 3 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/geojson/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/ward/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=20, stale-while-revalidate=20"
        }
      ]
    },
    {
      "source": "/api/(add-report|dictate|transcribe|tts|verify-document|plus-one|gov|admin|cron|inngest)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
