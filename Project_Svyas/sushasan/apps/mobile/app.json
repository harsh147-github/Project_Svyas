{
  "expo": {
    "name": "Sushaasan",
    "slug": "sushaasan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sushaasan",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.sushasan.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to detect your ward automatically",
        "NSCameraUsageDescription": "Used to attach photos to your civic reports",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to your civic reports"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "package": "in.sushasan.app",
      "permissions": ["ACCESS_FINE_LOCATION", "CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Used to detect your ward automatically" }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Used to attach photos to your civic reports" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
