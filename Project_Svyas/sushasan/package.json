{
  "name": "sushasan",
  "private": true,
  "version": "0.1.0",
  "description": "Sushasan — Government OS for Pune civic intelligence",
  "scripts": {
    "dev": "pnpm --filter @sushasan/web dev",
    "build": "pnpm --filter @sushasan/web build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @sushasan/db generate",
    "db:migrate": "pnpm --filter @sushasan/db migrate",
    "inngest:dev": "npx inngest-cli@latest dev"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@supabase/supabase-js": "^2.105.1",
    "inngest": "^4.2.6"
  }
}
