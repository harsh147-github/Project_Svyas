# Sushaasan — API Keys
# Copy this to .env and fill in your keys

# Reddit API (free) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=sushaasan-nibm-collector/1.0 (by /u/your_username)

# Google Maps API — https://console.cloud.google.com
# Enable: Places API, Routes API, Roads API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# TomTom Traffic API (free tier 2500 calls/day) — https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_key_here

# Apify (for Instagram scraping) — https://apify.com
# Free tier: $5 credit/month
APIFY_API_TOKEN=your_apify_token_here

# Future: Twitter/X API (paid)
# TWITTER_BEARER_TOKEN=your_bearer_token_here
