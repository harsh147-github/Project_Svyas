{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-site (python http.server)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "netlify-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["netlify", "dev", "--port", "8888"],
      "port": 8888
    },
    {
      "name": "sushaasan-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Project_Svyas/sushasan/apps/web", "run", "dev"],
      "port": 3000
    }
  ]
}
