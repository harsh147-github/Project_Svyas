{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/scrape/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily-pipeline",
      "schedule": "30 3 * * *"
    }
  ],
  "redirects": [
    { "source": "/ward/:id", "destination": "/dashboard/ward/:id", "permanent": false },
    { "source": "/gov",      "destination": "/dashboard/gov",      "permanent": false }
  ],
  "rewrites": [],
  "headers": [
    {
      "source": "/geojson/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=120, stale-while-revalidate=60" }
      ]
    }
  ]
}
