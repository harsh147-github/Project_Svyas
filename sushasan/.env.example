# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional: if set, POST /api/solution/generate requires x-generate-secret or Authorization: Bearer
# SOLUTION_GENERATE_SECRET=

# Apify (Twitter / Instagram actors — same token)
APIFY_API_TOKEN=apify_api_...
# Scrape mode: `instagram_twitter` (default, matches latest n8n) or `full` (Reddit+Twitter+Facebook+Instagram)
# N8N_SCRAPE_SOURCES=instagram_twitter
# Keywords passed to n8n-style Instagram + Twitter Apify actors
# N8N_SEARCH_KEYWORDS=NIBM Pune traffic Mohammadwadi Kondhwa
# Optional actor overrides (defaults: apify~instagram-scraper, apify~twitter-scraper)
# APIFY_N8N_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_N8N_TWITTER_ACTOR=apify~twitter-scraper
# Optional: Instagram hashtag scrape (actor input varies — verify in Apify Console)
APIFY_ENABLE_INSTAGRAM=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-hashtag-scraper
# n8n-style Instagram: launch → wait → dataset (used by daily pipeline). Sync actor also works.
# APIFY_INSTAGRAM_ASYNC=1

# Facebook (n8n branch) — Apify Facebook posts / groups actor
APIFY_ENABLE_FACEBOOK=
# Comma-separated public page or group URLs, or set APIFY_FACEBOOK_INPUT_JSON instead
# APIFY_FACEBOOK_START_URLS=https://www.facebook.com/groups/example
# APIFY_FACEBOOK_ACTOR_ID=apify~facebook-posts-scraper
# APIFY_FACEBOOK_MAX_POSTS=20
# Optional JSON override for the Instagram actor input object
# APIFY_INSTAGRAM_INPUT_JSON={"hashtags":["NIBM","PuneTraffic"],"resultsLimit":20}

# Reddit public JSON (read-only). Required format per Reddit API rules:
# https://github.com/reddit-archive/reddit/wiki/API
REDDIT_USER_AGENT=web:sushasan-pilot:0.1 (by /u/YourRedditUsername)
# Optional: comma-separated subreddits (default: pune,Pune_City)
# REDDIT_SUBREDDITS=pune,Pune_City

# RSS — extra feeds (comma URLs). Defaults already include Indian Express Pune + HT Pune.
# Add Pune Mirror etc. when you have a feed URL (e.g. from rss.app on punemirror.com/pune).
# SCRAPER_RSS_URLS=https://example.com/pune-mirror.xml

# Unified scrape pipeline auth (Vercel Cron uses CRON_SECRET automatically)
CRON_SECRET=generate_a_long_random_string
# Or use this name instead of CRON_SECRET for manual curl / Postman triggers
# SCRAPE_INGEST_SECRET=same_or_different_long_random_string

# Optional: monthly salt for author hashing (else YYYY-MM is used)
# AUTHOR_SALT=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Voyage (embeddings)
VOYAGE_API_KEY=pa-...

# Inngest (often auto-injected by Vercel Inngest integration)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Perplexity (research nodes in daily pipeline — optional until Phase 3 wired)
PERPLEXITY_API_KEY=pplx-...

# Resend (email)
RESEND_API_KEY=re_...

# Gov dashboard gate (set a strong random string)
GOV_ACCESS_TOKEN=change_me_strong_random_token

# Admin gate (set a strong random string)
ADMIN_TOKEN=change_me_strong_random_token

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# Plausible analytics
PLAUSIBLE_DOMAIN=sushasan.in

# Optional
SERPAPI_KEY=
